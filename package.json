{
  "name": "dokwa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --filter @dokwa/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "board": "python3 board.py",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:layers": "node tools/check-layers.mjs",
    "check": "pnpm lint && pnpm check:layers",
    "test:live": "pnpm -r --workspace-concurrency=2 --if-present run test:live"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0"
  }
}
